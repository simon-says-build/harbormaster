#!/usr/bin/env python3
"""firebase-ports — on-demand Firebase emulator port allocation.

A localhost daemon assigns emulator port BLOCKS from a pool and *remembers* a
sticky block per project (keyed by the project's directory). Any project's
emulators get stable, discoverable ports with NO hand-authored config and no
registry — new projects just work.

  up [--cwd DIR] [--only a,b] [--fresh] [--json|--env]
        Ensure the project's emulators are up on its remembered block (assign one
        the first time). Project = the firebase.json in DIR (default: $PWD, or the
        nearest firebase.json above it).
  down [--cwd DIR]        Stop the project's emulators (keeps its remembered block).
  ports [--cwd DIR] [--json|--env]
        Print the project's ports + project id (assigns a block if new). This is
        how consumers DISCOVER ports instead of hard-coding them.
  status                 Everything the daemon has up.
  acquire --isolated --cwd DIR [--only a,b] [--ttl N] [--json|--env]
        An EPHEMERAL instance: a fresh block + fresh data (concurrent runs / e2e),
        TTL-reaped. (Sticky `up` is for stable dev; isolated is for throwaway runs.)
  allocate [--ttl N] [--json]
        Reserve a free block WITHOUT booting — for a caller that boots its own
        suite (the agent-qa run driver) but wants race-free coordination.
  release <leaseId>      Release an isolated/reserved lease.
  leases                 Active isolated/reserved leases.
  serve                  Run the daemon (auto-starts on first command).

firebase.json must be PORTLESS (no emulator port numbers) — the daemon injects
them. Ports live only in the daemon's ledger: ~/.local/state/firebase-ports/.
"""

import fcntl
import http.client
import http.server
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path.home() / ".local" / "state" / "firebase-ports"
LEDGER = STATE_DIR / "ledger.json"

BROKER_HOST = "127.0.0.1"
BROKER_PORT = 4999
POOL_BASE = 11000            # port blocks live high, clear of app/default ports
BLOCK = 20                   # ports per block (covers offsets to +12, plus headroom)
POOL_BLOCKS = 200            # 11000-14999
# Offset of each emulator within a block. Kept in sync with the agent-qa run
# driver's derivation (config.sh / firebase-emulators.sh).
BLOCK_OFFSETS = {"auth": 0, "firestore": 1, "functions": 2, "storage": 3, "ui": 4,
                 "hub": 5, "logging": 6, "pubsub": 7, "eventarc": 8, "database": 9}
DEFAULT_TTL = 3600           # isolated/reserved lease seconds (TTL backstop)
RECLAIM_GRACE = int(os.environ.get("FBPORTS_RECLAIM_GRACE", "45"))
REAP_INTERVAL = int(os.environ.get("FBPORTS_REAP_INTERVAL", "15"))
READY_TIMEOUT = 180          # emulators can be slow to boot (Java, rules)


def _now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _port_open(port, host="127.0.0.1"):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((host, int(port))) == 0


def _all_open(ports):
    return bool(ports) and all(_port_open(p) for p in ports.values())


def _pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except (OSError, ProcessLookupError):
        return False
    return True


def _tail(path, n=25):
    try:
        return "\n".join(Path(path).read_text().splitlines()[-n:])
    except OSError:
        return ""


def _firebaserc_project(cwd):
    """The default project id from a dir's .firebaserc (what the emulator boots as)."""
    try:
        return json.loads((Path(cwd) / ".firebaserc").read_text()).get("projects", {}).get("default")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None


def _find_firebase_dir(start):
    """Nearest ancestor of `start` containing a firebase.json (the project root)."""
    p = Path(start).resolve()
    for d in [p, *p.parents]:
        if (d / "firebase.json").exists():
            return str(d)
    return None


def _block_ports(base):
    """Every emulator port for a block — the project uses whichever its config declares."""
    return {svc: base + off for svc, off in BLOCK_OFFSETS.items()}


def _service_ports(ports):
    """App-facing ports (skip the ui/hub/logging dashboards) for readiness checks."""
    return {s: p for s, p in ports.items() if s not in ("ui", "hub", "logging")}


def _write_injected_config(cwd, ports, only=None):
    """Copy the project's (portless) firebase.json and set ports on the emulators it
    DECLARES (plus hub/logging). We never ADD emulators the project doesn't use (e.g.
    functions) — that would make `firebase emulators:start` try to boot them and fail."""
    cfg = json.loads((Path(cwd) / "firebase.json").read_text())
    emu = cfg.setdefault("emulators", {})
    for svc in [k for k in emu if k != "singleProjectMode"]:
        if svc in ports and isinstance(emu[svc], dict):
            emu[svc]["port"] = ports[svc]
            if svc == "ui":
                emu[svc]["enabled"] = True
    for svc in ("hub", "logging"):          # dashboards/lanes — always give them a port
        emu.setdefault(svc, {})["port"] = ports[svc]
    emu["singleProjectMode"] = True
    tmp = f".firebase.brokered-{ports['firestore']}.json"
    (Path(cwd) / tmp).write_text(json.dumps(cfg, indent=2))
    return tmp


# ---- the daemon ----------------------------------------------------------

class Broker:
    def __init__(self):
        self.lock = threading.RLock()
        self.sticky = {}   # cwd -> {base, project_id, name, pid?, ports?, tmp_config?, log?, up?}
        self.leases = {}   # leaseId -> ephemeral (isolated/reserved) record
        self._load()
        self._reconcile()

    def _load(self):
        if LEDGER.exists():
            try:
                d = json.loads(LEDGER.read_text())
                self.sticky, self.leases = d.get("sticky", {}), d.get("leases", {})
            except (json.JSONDecodeError, OSError):
                pass

    def _save(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LEDGER.write_text(json.dumps({"sticky": self.sticky, "leases": self.leases}, indent=2))

    def _reconcile(self):
        # Sticky BLOCK assignments persist forever; only the running instance is transient.
        for cwd, s in self.sticky.items():
            if not (_pid_alive(s.get("pid")) and _all_open(_service_ports(s.get("ports") or {}))):
                s["pid"] = s["ports"] = s["tmp_config"] = None
        now = time.time()
        for lid in list(self.leases):
            l = self.leases[lid]
            if l["kind"] == "reserved":
                keep = l.get("expires") is None or l["expires"] > now
            else:
                keep = _pid_alive(l.get("pid")) and _all_open(_service_ports(l["ports"]))
            if not keep:
                self._cleanup(self.leases.pop(lid))
        self._save()

    def _used_blocks(self):
        u = {s["base"] for s in self.sticky.values() if s.get("base")}
        u |= {l["block"] for l in self.leases.values() if l.get("block")}
        return u

    def _free_block(self):
        used = self._used_blocks()
        for i in range(POOL_BLOCKS):
            base = POOL_BASE + i * BLOCK
            if base not in used and all(not _port_open(base + off) for off in range(BLOCK)):
                return base
        raise RuntimeError("emulator port pool exhausted")

    def _boot(self, cwd, ports, only, project_id, label):
        tmp = _write_injected_config(cwd, ports, only)
        log = STATE_DIR / f"{label}.log"
        cmd = ["firebase", "emulators:start", "--config", tmp]
        if only:
            cmd += ["--only", ",".join(only)]
        if project_id:
            cmd += ["--project", project_id]
        with open(log, "w") as lf:
            proc = subprocess.Popen(cmd, cwd=cwd, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
        check, deadline = _service_ports(ports), time.time() + READY_TIMEOUT
        while time.time() < deadline:
            if proc.poll() is not None:
                raise RuntimeError(f"emulators exited early; see {log}\n{_tail(log)}")
            if _all_open(check):
                return proc.pid, tmp, str(log)
            time.sleep(1)
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (OSError, ProcessLookupError):
            pass
        raise RuntimeError(f"timed out waiting for {list(check.values())}; see {log}")

    def _cleanup(self, rec):
        pid = rec.get("pid")
        if _pid_alive(pid):
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(os.getpgid(int(pid)), sig)
                except (OSError, ProcessLookupError):
                    break
                for _ in range(50):
                    if not _pid_alive(pid):
                        break
                    time.sleep(0.1)
                if not _pid_alive(pid):
                    break
        tmp = rec.get("tmp_config")
        if tmp and rec.get("cwd") and (Path(rec["cwd"]) / tmp).exists():
            (Path(rec["cwd"]) / tmp).unlink()

    # --- sticky (stable, per-project, remembered) ---
    def assign(self, cwd):
        """Get or create a project's remembered block (no boot)."""
        s = self.sticky.get(cwd)
        if not s:
            base = self._free_block()
            s = {"base": base, "project_id": _firebaserc_project(cwd), "name": Path(cwd).name,
                 "pid": None, "ports": None, "tmp_config": None, "log": None}
            self.sticky[cwd] = s
            self._save()
        return s

    def _describe(self, cwd, s, up):
        return {"cwd": cwd, "name": s["name"], "projectId": s["project_id"],
                "ports": _block_ports(s["base"]), "up": up}

    def up(self, cwd, only=None, fresh=False):
        with self.lock:
            s = self.assign(cwd)
            ports = _block_ports(s["base"])
            live = _pid_alive(s.get("pid")) and _all_open(_service_ports(s.get("ports") or {}))
            if live and not fresh:
                return {**self._describe(cwd, s, True), "reused": True}
            if live and fresh:
                self._cleanup(s)
            pid, tmp, log = self._boot(cwd, ports, only, s["project_id"], s["name"])
            s.update(pid=pid, ports=ports, tmp_config=tmp, log=log, only=only)
            self._save()
            return {**self._describe(cwd, s, True), "reused": False}

    def down(self, cwd):
        with self.lock:
            s = self.sticky.get(cwd)
            if not s:
                return {"stopped": False, "reason": "unknown project"}
            self._cleanup(s)
            s["pid"] = s["ports"] = s["tmp_config"] = None
            self._save()
            return {"stopped": True}

    def ports(self, cwd):
        with self.lock:
            s = self.assign(cwd)
            return self._describe(cwd, s, _pid_alive(s.get("pid")))

    # --- isolated / reserved (ephemeral) ---
    def acquire_isolated(self, cwd, only=None, project_id=None, ttl=DEFAULT_TTL):
        with self.lock:
            base = self._free_block()
            ports = _block_ports(base)
            lid = f"run:{uuid.uuid4().hex[:12]}"
            project_id = project_id or _firebaserc_project(cwd)
            pid, tmp, log = self._boot(cwd, ports, only, project_id, lid.replace(":", "-"))
            self.leases[lid] = {"leaseId": lid, "kind": "isolated", "cwd": cwd, "block": base,
                                "ports": ports, "pid": pid, "tmp_config": tmp, "log": log,
                                "project_id": project_id, "started": _now(), "expires": time.time() + ttl}
            self._save()
            return {"leaseId": lid, "ports": ports, "projectId": project_id, "reused": False}

    def allocate(self, ttl=DEFAULT_TTL, label=None):
        with self.lock:
            base = self._free_block()
            lid = f"alloc:{uuid.uuid4().hex[:12]}"
            self.leases[lid] = {"leaseId": lid, "kind": "reserved", "block": base, "pid": None,
                                "cwd": None, "tmp_config": None, "ports": {"base": base},
                                "label": label, "started": _now(), "expires": time.time() + ttl}
            self._save()
            return {"leaseId": lid, "base": base}

    def release(self, lid):
        with self.lock:
            rec = self.leases.pop(lid, None)
            if not rec:
                return {"released": False, "reason": "unknown lease"}
            self._cleanup(rec)
            self._save()
            return {"released": True}

    def heartbeat(self, lid, ttl=DEFAULT_TTL):
        with self.lock:
            rec = self.leases.get(lid)
            if rec and rec.get("expires") is not None:
                rec["expires"] = time.time() + ttl
                self._save()
            return {"ok": bool(rec)}

    def status(self):
        with self.lock:
            sticky = [self._describe(cwd, s, _pid_alive(s.get("pid"))) for cwd, s in self.sticky.items()]
            leases = [{"leaseId": l["leaseId"], "kind": l["kind"], "cwd": l.get("cwd"),
                       "up": _pid_alive(l.get("pid")), "ports": l["ports"],
                       "expires": l.get("expires")} for l in self.leases.values()]
            return {"sticky": sticky, "leases": leases}

    def reap(self):
        with self.lock:
            now = time.time()
            for lid in list(self.leases):
                l = self.leases[lid]
                exp = l.get("expires")
                expired = exp is not None and exp < now
                if l["kind"] == "reserved":
                    base = l["block"]
                    if _port_open(base) or _port_open(base + 1):
                        l["seen_active"], l["down_since"] = True, None
                    elif l.get("seen_active"):
                        l["down_since"] = l.get("down_since") or now
                    reclaim = bool(l.get("down_since")) and now - l["down_since"] >= RECLAIM_GRACE
                    dead = expired or reclaim
                else:
                    dead = expired or not _pid_alive(l.get("pid"))
                if dead:
                    self._cleanup(self.leases.pop(lid))
            self._save()


class _Handler(http.server.BaseHTTPRequestHandler):
    broker = None

    def log_message(self, *_):
        pass

    def _send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except json.JSONDecodeError:
            return {}

    def do_GET(self):
        if self.path == "/health":
            return self._send(200, {"ok": True})
        if self.path == "/status":
            return self._send(200, self.broker.status())
        self._send(404, {"error": "not found"})

    def do_POST(self):
        b, body = self.broker, self._body()
        try:
            if self.path == "/up":
                return self._send(200, b.up(body["cwd"], body.get("only"), body.get("fresh", False)))
            if self.path == "/down":
                return self._send(200, b.down(body["cwd"]))
            if self.path == "/ports":
                return self._send(200, b.ports(body["cwd"]))
            if self.path == "/acquire":
                return self._send(200, b.acquire_isolated(body["cwd"], body.get("only"),
                                                          body.get("project_id"), body.get("ttl", DEFAULT_TTL)))
            if self.path == "/allocate":
                return self._send(200, b.allocate(body.get("ttl", DEFAULT_TTL), body.get("label")))
            if self.path == "/release":
                return self._send(200, b.release(body.get("leaseId")))
            if self.path == "/heartbeat":
                return self._send(200, b.heartbeat(body.get("leaseId"), body.get("ttl", DEFAULT_TTL)))
            if self.path == "/shutdown":
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return self._send(200, {"ok": True})
            self._send(404, {"error": "not found"})
        except Exception as e:
            self._send(500, {"error": str(e)})


def cmd_serve():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    _Handler.broker = Broker()
    srv = http.server.ThreadingHTTPServer((BROKER_HOST, BROKER_PORT), _Handler)

    def reaper():
        while True:
            time.sleep(REAP_INTERVAL)
            try:
                _Handler.broker.reap()
            except Exception:
                pass

    threading.Thread(target=reaper, daemon=True).start()
    print(f"firebase-ports daemon on http://{BROKER_HOST}:{BROKER_PORT} "
          f"(pool {POOL_BASE}-{POOL_BASE + POOL_BLOCKS * BLOCK - 1})")
    srv.serve_forever()


# ---- client --------------------------------------------------------------

def _call(method, path, body=None, timeout=READY_TIMEOUT):
    conn = http.client.HTTPConnection(BROKER_HOST, BROKER_PORT, timeout=timeout)
    data = json.dumps(body).encode() if body is not None else None
    conn.request(method, path, body=data, headers={"Content-Type": "application/json"} if data else {})
    resp = conn.getresponse()
    out = json.loads(resp.read() or b"{}")
    conn.close()
    return resp.status, out


def _up():
    try:
        return _call("GET", "/health", timeout=1)[0] == 200
    except OSError:
        return False


def _ensure():
    if _up():
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(STATE_DIR / "daemon.log", "a")
    subprocess.Popen([sys.argv[0], "serve"], stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(50):
        if _up():
            return
        time.sleep(0.1)
    raise RuntimeError("daemon failed to start (see ~/.local/state/firebase-ports/daemon.log)")


def _resolve_cwd(opts):
    cwd = opts.get("cwd") or _find_firebase_dir(os.getcwd())
    if not cwd or not (Path(cwd) / "firebase.json").exists():
        print("no firebase.json here — run inside a project or pass --cwd DIR", file=sys.stderr)
        sys.exit(1)
    return str(Path(cwd).resolve())


def _print(out, fmt):
    ports, pid = out.get("ports", {}), out.get("projectId")
    if fmt == "json":
        print(json.dumps(out))
    elif fmt == "env":
        if pid:
            print(f"export GCLOUD_PROJECT={pid}")
            print(f"export GOOGLE_CLOUD_PROJECT={pid}")
        for svc, port in ports.items():
            print(f"export FIREBASE_{svc.upper()}_EMULATOR_PORT={port}")
    else:
        head = out.get("leaseId") or out.get("name") or ""
        state = "reused" if out.get("reused") else ("up" if out.get("up") else "leased")
        print(f"{head} {state}".strip() + (f"  ({pid})" if pid else ""))
        for svc, port in ports.items():
            print(f"    {svc:<10} 127.0.0.1:{port}")


def _parse(args):
    pos, flags, opts = [], set(), {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            if "=" in a:
                k, v = a[2:].split("=", 1)
                opts[k] = v
            elif a[2:] in ("cwd", "only", "ttl") and i + 1 < len(args):
                opts[a[2:]] = args[i + 1]
                i += 1
            else:
                flags.add(a[2:])
        else:
            pos.append(a)
        i += 1
    return pos, flags, opts


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    cmd = sys.argv[1]
    pos, flags, opts = _parse(sys.argv[2:])
    fmt = "json" if "json" in flags else "env" if "env" in flags else "human"
    only = opts["only"].split(",") if opts.get("only") else None

    def ok(res, verb):
        st, out = res
        if st != 200:
            print(f"{verb} failed: {out.get('error', out)}", file=sys.stderr)
            sys.exit(1)
        return out

    if cmd == "serve":
        cmd_serve()
    elif cmd == "up":
        _ensure()
        _print(ok(_call("POST", "/up", {"cwd": _resolve_cwd(opts), "only": only, "fresh": "fresh" in flags}), "up"), fmt)
    elif cmd == "down":
        if _up():
            out = _call("POST", "/down", {"cwd": _resolve_cwd(opts)})[1]
            print("stopped" if out.get("stopped") else f"not stopped: {out.get('reason')}")
        else:
            print("daemon not running")
    elif cmd == "ports":
        _ensure()
        _print(ok(_call("POST", "/ports", {"cwd": _resolve_cwd(opts)}), "ports"), fmt)
    elif cmd == "status":
        if not _up():
            print("daemon not running.")
            return
        st = _call("GET", "/status")[1]
        for s in st.get("sticky", []):
            print(f"{s['name']:<20} {'up' if s['up'] else 'down':<5} {s.get('projectId') or '-':<16} "
                  f"firestore:{s['ports'].get('firestore')}  {s['cwd']}")
        for l in st.get("leases", []):
            exp = l.get("expires")
            ttl = "" if exp is None else f"  ttl~{max(0, int(exp - time.time()))}s"
            where = f"base:{l['ports']['base']}" if l["kind"] == "reserved" else f"firestore:{l['ports'].get('firestore')}"
            print(f"{l['leaseId']:<22} {l['kind']:<9} {'up' if l['up'] else '-':<4} {where}{ttl}")
        if not st.get("sticky") and not st.get("leases"):
            print("nothing running.")
    elif cmd == "acquire":
        _ensure()
        _print(ok(_call("POST", "/acquire", {"cwd": _resolve_cwd(opts), "only": only,
                                             "ttl": int(opts.get("ttl", DEFAULT_TTL))}), "acquire"), fmt)
    elif cmd == "allocate":
        _ensure()
        status, out = _call("POST", "/allocate", {"ttl": int(opts.get("ttl", DEFAULT_TTL)), "label": opts.get("label")})
        print(json.dumps(out) if fmt == "json" else f"{out['leaseId']}  base {out['base']}")
    elif cmd == "release":
        if _up() and pos:
            out = _call("POST", "/release", {"leaseId": pos[0]})[1]
            print("released" if out.get("released") else f"not released: {out.get('reason')}")
        else:
            print("nothing to release")
    elif cmd == "leases":
        main_status_leases()
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print("Commands: up, down, ports, status, acquire, allocate, release, leases, serve", file=sys.stderr)
        sys.exit(1)


def main_status_leases():
    if not _up():
        print("daemon not running.")
        return
    leases = _call("GET", "/status")[1].get("leases", [])
    if not leases:
        print("no active leases.")
        return
    for l in leases:
        exp = l.get("expires")
        ttl = "" if exp is None else f"  ttl~{max(0, int(exp - time.time()))}s"
        where = f"base:{l['ports']['base']}" if l["kind"] == "reserved" else f"firestore:{l['ports'].get('firestore')}"
        print(f"{l['leaseId']:<22} {l['kind']:<9} {'up' if l['up'] else '-':<4} {where}{ttl}")


if __name__ == "__main__":
    main()
